# Local-only MAVIS/Copilot BYOK configuration.
# This file is Git-ignored. Replace all angle-bracket placeholders with values
# issued by Magna/MAVIS. Never put access tokens, refresh tokens, or cookies here.

PROVIDER_NAME=Magna MAVIS
API_BASE_URL=<API_BASE_URL>
API_ENDPOINTS=<API_ENDPOINTS>
SCOPES=<SCOPES>

# Obtain these from the MAVIS OAuth application registration.
AUTHORIZATION_URL=
TOKEN_URL=<TOKEN_URL>
DEVICE_AUTHORIZATION_URL=
OAUTH_CLIENT_ID=<OAUTH_CLIENT_ID>
OAUTH_CLIENT_SECRET=
OAUTH_FLOW=auto

# Context allowlist/settings.
CONTEXT_FIELDS=id,title,summary,status,created_at,updated_at
API_PAGE_PARAM=page
API_PAGE_SIZE_PARAM=page_size
API_PAGE_SIZE=50
API_MAX_PAGES=20
API_MAX_ITEMS=500
API_DATE_FROM_PARAM=
API_DATE_FROM=
MAX_OUTPUT_BYTES=1000000

# MAVIS values observed in the HAR.
MAVIS_API_BASE_URL=https://mavis.magna.com/mavis
MAVIS_USER_ID=<YOUR_MAVIS_USER_ID>
# Active HAR requests used gpt-5.6-luna; confirm before changing this.
MAVIS_MODEL_ID=gpt-5.6-luna
MAVIS_PROXY_HOST=127.0.0.1
MAVIS_PROXY_PORT=8765
MAVIS_WEB_SEARCH=false
