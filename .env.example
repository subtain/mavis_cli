# Copy this file to .env or set these values in the process environment.
# Do not commit .env or any token/secret.

PROVIDER_NAME=<PROVIDER_NAME>
API_BASE_URL=<API_BASE_URL>
API_ENDPOINTS=<API_ENDPOINTS>
SCOPES=<SCOPES>

# OAuth endpoints must come from the provider's documentation/registration.
AUTHORIZATION_URL=<AUTHORIZATION_URL>
TOKEN_URL=<TOKEN_URL>
DEVICE_AUTHORIZATION_URL=<DEVICE_AUTHORIZATION_URL>
OAUTH_CLIENT_ID=<OAUTH_CLIENT_ID>
OAUTH_CLIENT_SECRET=

# auto prefers Device Authorization when DEVICE_AUTHORIZATION_URL is set.
# Valid values: auto, device, authorization_code_pkce, client_credentials
OAUTH_FLOW=auto

# Set CONTEXT_FIELDS to a comma-separated allowlist of useful fields.
# Nested fields are supported, for example: id,title,owner.name,updated_at
CONTEXT_FIELDS=id,title,summary,status,created_at,updated_at

# Pagination/filtering controls. Leave API_DATE_FROM_* empty if unsupported.
API_PAGE_PARAM=page
API_PAGE_SIZE_PARAM=page_size
API_PAGE_SIZE=50
API_MAX_PAGES=20
API_MAX_ITEMS=500
API_DATE_FROM_PARAM=
API_DATE_FROM=
MAX_OUTPUT_BYTES=1000000
